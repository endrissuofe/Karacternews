# --- Database (PostgreSQL, local via Docker Compose) ---

# Password for the local Postgres container. Used by both docker-compose.yml
# and the DATABASE_URL below — must match.
POSTGRES_PASSWORD=changeme

# Full Postgres connection string Payload uses. Local dev via docker-compose.yml,
# user/db are "karacter" (adjust if you rename them).
DATABASE_URL=postgres://karacter:changeme@127.0.0.1:5432/karacter

# --- Payload ---

# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site, no trailing slash. Used for CORS, links, etc.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron/scheduled jobs. Generate with: openssl rand -hex 32
CRON_SECRET=

# Secret used to validate draft-preview requests. Generate with: openssl rand -hex 32
PREVIEW_SECRET=

# --- Brevo (newsletter capture, Increment 4) ---

# API key from Brevo → Settings → SMTP & API → API keys. Server-side only.
BREVO_API_KEY=

# Optional: numeric ID of the Brevo contact list to add signups to.
# Leave empty to add contacts without a list.
BREVO_LIST_ID=

# --- Cloudflare R2 (podcast audio storage, Increment 5) ---
# S3-compatible credentials: Cloudflare dashboard → R2 → Manage API Tokens
# (Object Read & Write, scoped to the bucket). When these are empty, audio
# uploads fall back to local file storage (fine for dev/CI).

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=karacter-media
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Set to true on deployed servers ONLY. Makes a missing/typo'd R2 var fail the
# boot instead of silently falling back to local media storage (which loses
# uploads on the next deploy). Leave empty on dev machines and in CI.
REQUIRE_R2=

# Local dev ONLY. Enables the admin "Seed your database" button and the
# /next/seed route, which DELETE every article, category and tag before
# inserting demo content. Never set this on Vercel or any deployed server.
ALLOW_SEED=

# --- Deployment (Increment 5.5, server only) ---

# Domain Caddy should serve with automatic HTTPS (e.g. karacter.ng).
# Leave empty on dev machines; before a domain exists, UAT runs on :80.
SITE_DOMAIN=

# Which compose file this host runs. The Oracle AMD micro (ADR-0005) uses
# infra/docker-compose.micro.yml, which is the default — set this only if
# the host builds on-box with infra/docker-compose.prod.yml instead.
KARACTER_COMPOSE=

# Pin the app image to a specific commit for rollback, e.g.
# ghcr.io/endrissuofe/karacternews:<sha>. Empty uses :latest.
IMAGE=

# healthchecks.io ping URL for the nightly backup (infra/scripts/backup.sh).
# The script pings it on success and <url>/fail on failure, so a backup that
# silently stops running raises an alert. Strongly recommended: the Oct 2026
# outage went unnoticed for 19 days because nothing watched this job.
BACKUP_HEALTHCHECK_URL=

# Managed Postgres only (Vercel + Neon, ADR-0006): set in GitHub Actions
# secrets, not on a server. backup.sh dumps this URL directly instead of
# going through the compose postgres container. Use Neon's DIRECT
# (non-pooled) connection string — pg_dump does not work through a pooler.
BACKUP_DATABASE_URL=
